from lsst.ts.pyilc.pdu import ServerIDRequest, ServerStatusRequest, ChangeILCMode, ReadMezzaninePressureRequest, ForceActuatorForceDemandDARequest, ForceActuatorForceAndStatusRequest, ILCMode

await context.change_mode(address, ILCMode.ENABLED)
print(f"ILC {address} mode changed to ENABLED.")

id = await context.execute(ServerIDRequest(address))
print(id)

status = await context.execute(ServerStatusRequest(address))
print(status)

await context.execute(ForceActuatorForceDemandDARequest(address, 0, 2000, 0))

for i in range(2):
    forces = await context.execute(ForceActuatorForceAndStatusRequest(address))
    pressures = await context.execute(ReadMezzaninePressureRequest(address))

    print("Forces: ", forces)
    print("Pressures: ", pressures)
